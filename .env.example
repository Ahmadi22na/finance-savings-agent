# ============================================
# Finance & Savings Agent — Environment Config
# انسخ هاد الملف لـ .env واملأ القيم الفعلية
# لا تحط أي قيمة حقيقية بهاد الملف (.env.example) أبدًا
# ============================================

# --- Database ---
POSTGRES_USER=finance_app
POSTGRES_PASSWORD=
POSTGRES_DB=finance_savings_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://finance_app:@db:5432/finance_savings_db

# --- Backend (Flask) ---
FLASK_ENV=development
FLASK_SECRET_KEY=
FLASK_APP=app

# --- AI Provider (قابل للتبديل — انظر قسم 3 بالتوثيق) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Auth (لسا مو محسوم آلية التوثيق النهائية — Placeholder) ---
JWT_SECRET_KEY=
JWT_EXPIRATION_MINUTES=60
